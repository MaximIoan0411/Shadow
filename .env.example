# Setările backend-ului. Copiați în .env (în rădăcina repo-ului sau în backend/). Fișierul .env NU intră în git.
# Fără .env backend-ul pornește oricum, cu valorile de mai jos.

# Secretul tokenurilor de acces: cel puțin 32 de caractere, la întâmplare. Lăsat gol (sau prea scurt), backend-ul
# folosește unul aleator la fiecare pornire, deci sesiunile se încheie când repornește.
JWT_SECRET=
# Cheia legăturii navă ↔ Pământ, în Base64 (32 de octeți). Lăsată goală, se citește din security/keys/keys_files/,
# unde backend-ul creează singur cheile care lipsesc. `python security/keys/generate_keys.py --env` o afișează.
LINK_AES_KEY_B64=
# Doar pentru teste: cu `true`, `Bearer mock-<utilizator>` intră FĂRĂ parolă. Nu porniți în demo.
ALLOW_MOCK_TOKENS=false

TIME_SCALE=60
DATABASE_URL=sqlite+aiosqlite:///./shadow.sqlite
RESET_DB_ON_START=true
DATA_DIR=../data
KEYS_DIR=../security/keys
# serviciul AI (folderul ai/); modelul lui se alege în ai/.env, vezi ai/.env.example
AI_URL=http://127.0.0.1:8001
AI_TIMEOUT_S=20
CORS_ORIGINS=["http://localhost:3000"]
