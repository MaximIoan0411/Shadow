# Copiați în ai/.env (nu intră în git) și completați cu ce afișează notebook-ul de Colab.
# Fără SHADOW_LLM_URL serviciul rulează ca mock (reformulează recomandarea din catalog, fără model).
SHADOW_LLM_URL=
SHADOW_LLM_API_KEY=
# colab_simulation = modelul rulează pe Colab (simularea calculatorului de bord); local = llama-server pe acest calculator
SHADOW_LLM_MODE=colab_simulation
# câte secunde așteaptă serviciul modelul; backend-ul renunță oricum după 20 s
SHADOW_LLM_TIMEOUT=15
